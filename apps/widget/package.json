{
  "name": "@importflow/widget",
  "version": "1.10.0",
  "author": "Jawad",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "cross-env PORT=3500 BROWSER=none craco start",
    "start:dev": "cross-env PORT=3500 BROWSER=none craco start",
    "prebuild": "rimraf build",
    "build": "craco build",
    "precommit": "lint-staged",
    "eject": "craco eject",
    "lint": "eslint src",
    "envsetup:docker": "chmod +x ./env.sh && ./env.sh && mv ./env-config.js ./build/env-config.js",
    "start:static:build": "pnpm envsetup:docker && http-server build -p 3500 --proxy http://localhost:3500?",
    "start:docker": "pnpm build && pnpm start:static:build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "dependencies": {
    "@craco/craco": "^6.4.3",
    "@emotion/react": "^11.8.2",
    "@handsontable/react": "^11.1.0",
    "@importflow/client": "workspace:^",
    "@importflow/shared": "workspace:^",
    "@mantine/colors-generator": "^7.17.2",
    "@mantine/core": "4.0.4",
    "@mantine/dates": "4.0.4",
    "@mantine/dropzone": "4.0.4",
    "@mantine/hooks": "4.0.4",
    "@mantine/notifications": "4.0.4",
    "@sentry/react": "^6.18.2",
    "@storybook/addon-essentials": "^6.4.19",
    "@storybook/react": "^6.4.19",
    "@tanstack/react-query": "^4.14.5",
    "axios": "0.26.1",
    "cooltipz-css": "^2.1.0",
    "cross-env": "^7.0.3",
    "file-saver": "^2.0.5",
    "handsontable": "^11.1.0",
    "http-server": "^14.1.0",
    "jszip": "^3.7.1",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-hook-form": "^7.28.0",
    "react-router-dom": "^6.2.2",
    "react-scripts": "5.0.0",
    "rimraf": "^3.0.2",
    "socket.io": "^4.4.1",
    "socket.io-client": "^4.4.1",
    "tippy.js": "^6.3.7",
    "web-vitals": "^2.1.4",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.16.7",
    "@types/file-saver": "^2.0.5",
    "@types/react": "^17.0.40",
    "@types/react-datepicker": "^4.3.4",
    "@types/react-dom": "^17.0.13",
    "ts-loader": "^9.2.8",
    "typescript": "^4.6.2"
  }
}
