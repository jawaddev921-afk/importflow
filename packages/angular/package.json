{
  "name": "@importflow/angular",
  "version": "1.10.0",
  "description": "Angular library to show CSV Excel Importer in angular applications",
  "license": "MIT",
  "author": "Jawad",
  "repository": "https://github.com/jawaddev921-afk/importflow",
  "types": "dist/index.d.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "keywords": [
    "importflow",
    "importflowhq",
    "data-import",
    "excel-import",
    "csv-import"
  ],
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
